<Window x:Class="DataAnalizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lucide="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Real Estate Data Platform"
        Height="768" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#f8fafc"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1e293b"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0f172a" CornerRadius="0,20,20,0" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                    <lucide:PackIconLucide Kind="Building2" Foreground="#4f46e5" Width="28" Height="28"/>
                    <TextBlock Text="RealData" Foreground="White" FontSize="22" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,20,15,0" IsEnabled="{Binding IsLoggedIn}">
                    <TextBlock Text="MAIN MENU" Foreground="#64748b" FontSize="11" FontWeight="Bold" Margin="10,0,0,10"/>

                    <Button x:Name="BtnDashboard" Click="BtnDashboard_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <lucide:PackIconLucide Kind="LayoutDashboard" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnHistory" Click="BtnHistory_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <lucide:PackIconLucide Kind="History" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="History &amp; Logs" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCityLookup" Click="BtnCityLookup_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <lucide:PackIconLucide Kind="MapPin" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="City Lookup" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Background="#1e293b" CornerRadius="12" Margin="15,0,15,20" Padding="15">
                    <StackPanel>
                        <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Session Active" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Click below to sign out" Foreground="#94a3b8" FontSize="12" Margin="0,2,0,10"/>
                            <Button Command="{Binding LogoutCommand}" Content="Log out" Background="#b91c1c" Foreground="White" BorderThickness="0" Padding="0,6" Cursor="Hand" FontWeight="Medium"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsLoggedOut, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Authentication" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Please sign in to access data" Foreground="#94a3b8" FontSize="12" Margin="0,2,0,10"/>
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Login" Content="Log in" Background="#4f46e5" Foreground="White" BorderThickness="0" Padding="0,6" Cursor="Hand" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#f1f5f9" CornerRadius="8" Width="400" HorizontalAlignment="Left" Height="36" Padding="10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <lucide:PackIconLucide Kind="Search" Foreground="#94a3b8" Width="16" Height="16"/>
                            <TextBox BorderThickness="0" Background="Transparent" Foreground="#334155" Margin="10,0,0,0" Width="350" VerticalAlignment="Center" Text="Search across reports, cities, or IDs..."/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsLoggedIn}">
                        <Button Click="BtnProfile_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Border Background="#e0e7ff" CornerRadius="16" Width="32" Height="32">
                                <lucide:PackIconLucide Kind="User" Foreground="#4f46e5" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="MainContentControl" Grid.Row="1" Margin="30"/>
        </Grid>
    </Grid>
</Window>