<UserControl x:Class="DataAnalizer.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f8fafc">
    <Grid Margin="40">
        <Border Background="White" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1" Padding="30" HorizontalAlignment="Left" VerticalAlignment="Top" Width="400">
            <StackPanel>
                <TextBlock Text="Mój Profil" FontSize="24" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,20"/>
                <Separator Background="#e2e8f0" Margin="0,0,0,20"/>
                
                <TextBlock Text="Zalogowany jako:" FontSize="14" Foreground="#64748b" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Username}" FontSize="18" FontWeight="SemiBold" Foreground="#0f172a" Margin="0,0,0,20"/>

                <TextBlock Text="Status konta:" FontSize="14" Foreground="#64748b" Margin="0,0,0,4"/>
                <TextBlock Text="Administrator" FontSize="16" FontWeight="Medium" Foreground="#4f46e5" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>