<UserControl x:Class="DataAnalizer.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lucide="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#f8fafc"
             FontFamily="Segoe UI">
    <Grid Margin="40">
        <Border Background="White" CornerRadius="16" BorderBrush="#e2e8f0" BorderThickness="1" Padding="35" HorizontalAlignment="Left" VerticalAlignment="Top" Width="550">
            <StackPanel>
                <TextBlock Text="Mój Profil" FontSize="24" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,20"/>
                <Separator Background="#e2e8f0" Margin="0,0,0,25"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#e0e7ff" CornerRadius="45" Width="90" Height="90" VerticalAlignment="Top" Margin="0,0,25,0">
                        <lucide:PackIconLucide Kind="User" Foreground="#4f46e5" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="{Binding Username}" FontSize="22" FontWeight="Bold" Foreground="#0f172a" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Ostatnia aktywność" FontSize="12" FontWeight="SemiBold" Foreground="#64748b" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <lucide:PackIconLucide Kind="Clock" Foreground="#94a3b8" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding LastLoginTime}" FontSize="15" Foreground="#334155" FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>